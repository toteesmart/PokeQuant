#!/bin/sh
# pre-push — opt-in local verify gate. Not wired by default; the human
# opts in per clone (see PokeQuantMobile/docs/RELEASE.md, "Git hooks"):
#   git config core.hooksPath PokeQuantMobile/tools/hooks
#
# Mirrors the mobile-ci.yml path filter: if the push range touches no
# file under PokeQuantMobile/**, worker*.js, worker_show_vendor/**, or
# .github/workflows/mobile-ci.yml, the push proceeds without paying the
# ~1200-test composite (PWA-only pushes stay free). Otherwise the hook
# runs `npm run verify` from PokeQuantMobile/ and its exit code gates
# the push. Git invokes hooks from the worktree root, so the relative
# cd below is anchored there.

set -u

remote_name=$1
zero=0000000000000000000000000000000000000000
needs_verify=0

while read -r local_ref local_sha remote_ref remote_sha || [ -n "$local_ref" ]; do
  # Ref deletion carries no local object — nothing to verify.
  [ "$local_sha" = "$zero" ] && continue

  if [ "$remote_sha" = "$zero" ]; then
    # New remote ref: files touched by commits the remote lacks. A
    # push to a URL (no remote-tracking refs match) scans the full
    # history — the fail-safe direction is toward verifying.
    if ! files=$(git log --format= --name-only "$local_sha" \
        --not --remotes="$remote_name" 2>/dev/null); then
      needs_verify=1
      break
    fi
  elif ! files=$(git diff --name-only "$remote_sha" "$local_sha" 2>/dev/null); then
    # Unreadable range (e.g. force-pushed history not held locally) —
    # verify rather than silently skip.
    needs_verify=1
    break
  fi

  while IFS= read -r file; do
    case $file in
      PokeQuantMobile/* | worker*.js | worker_show_vendor/* | .github/workflows/mobile-ci.yml)
        needs_verify=1
        break
        ;;
    esac
  done <<EOF
$files
EOF

  [ "$needs_verify" -eq 1 ] && break
done

if [ "$needs_verify" -eq 0 ]; then
  echo "pre-push: no mobile/worker-path changes — skipping npm run verify"
  exit 0
fi

echo "pre-push: mobile/worker-path changes — running npm run verify"
cd PokeQuantMobile || exit 1
npm run verify
