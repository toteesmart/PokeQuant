{
  "expo": {
    "name": "Card Cache",
    "slug": "PokeQuantMobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.toteesmart.PokeQuantMobile",
      "infoPlist": {
